#version 460
// SPDX-License-Identifier: Apache-2.0
//
// Compute per-gaussian enclosing *icosahedron* geometry (12 vertices, 20
// triangles each). Ports computeGaussianEnclosingIcosaHedronKernel from
// particlePrimitives.cu. Outputs:
//   verts: float[]  -> (gid*12 + i)*3 + c   (world-space vertex positions)
//   idx:   uint[]   -> (gid*20 + t)*3 + k   (global vertex indices)
// consumed as the geometry of a VK_GEOMETRY_TYPE_TRIANGLES_KHR BLAS.
// The index buffer only depends on the gaussian count, so it is written only when
// ap.writeIndices is set (the host sets it when the count changed). The scene
// bounds (min/max over all vertices, the rays' clip box) are reduced here into
// `bounds` (6 uints, order-preserving float encoding) for the host to read back.

#extension GL_EXT_scalar_block_layout : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

layout(local_size_x = 256) in;

const uint NUM_VERT = 12u;
const uint NUM_TRI  = 20u;
const float GOLDEN  = 1.618033988749895;
const float ICOSA_EDGE = 1.323169076499215;
const float ICOSA_VRT_SCALE = 0.5 * ICOSA_EDGE;

layout(set = 0, binding = 0, scalar) uniform AabbParams {
    uint  numGaussians;
    int   kernelDegree;
    int   densityClamping;
    float minResponse;
    uint  blasRefLo;
    uint  blasRefHi;
    uint  writeIndices;
} ap;

layout(set = 0, binding = 1, scalar) readonly buffer Pos { float v[]; } pos;
layout(set = 0, binding = 2, scalar) readonly buffer Rot { float v[]; } rot;
layout(set = 0, binding = 3, scalar) readonly buffer Scl { float v[]; } scl;
layout(set = 0, binding = 4, scalar) readonly buffer Dns { float v[]; } dns;
layout(set = 0, binding = 5, scalar) writeonly buffer Verts { float v[]; } verts;
layout(set = 0, binding = 6, scalar) writeonly buffer Idx   { uint  v[]; } idx;
layout(set = 0, binding = 7, scalar) buffer Bounds { uint v[6]; } bounds;   // min xyz, max xyz

// float <-> uint with the same ordering, so atomicMin/Max on uint order floats
uint orderedBits(float f) {
    uint u = floatBitsToUint(f);
    return (u & 0x80000000u) != 0u ? ~u : (u | 0x80000000u);
}

float kernelScale(float density, float modulatedMinResponse, int densityClamping, int degree) {
    float responseModulation = (densityClamping != 0) ? density : 1.0;
    float minResp = min(modulatedMinResponse / responseModulation, 0.97);
    if (degree < 0) {
        float k = float(abs(degree));
        float s = 1.0 / pow(3.0, k);
        return pow((1.0 / (log(minResp) - 1.0) + 1.0) / s, 1.0 / k);
    }
    if (degree == 0) {
        return ((1.0 - minResp) / 3.0) / -0.329630334487;
    }
    float b = float(degree);
    float a = -4.5 / pow(3.0, b);
    return pow(log(minResp) / a, 1.0 / b);
}

void quatToMatrixTranspose(vec4 q, out vec3 T0, out vec3 T1, out vec3 T2) {
    float r = q.x, x = q.y, y = q.z, z = q.w;
    T0 = vec3(1.0 - 2.0*(y*y + z*z), 2.0*(x*y - r*z),       2.0*(x*z + r*y));
    T1 = vec3(2.0*(x*y + r*z),       1.0 - 2.0*(x*x + z*z), 2.0*(y*z - r*x));
    T2 = vec3(2.0*(x*z - r*y),       2.0*(y*z + r*x),       1.0 - 2.0*(x*x + y*y));
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= ap.numGaussians) return;

    vec4 q     = vec4(rot.v[gid*4+0], rot.v[gid*4+1], rot.v[gid*4+2], rot.v[gid*4+3]);
    vec3 scale = vec3(scl.v[gid*3+0], scl.v[gid*3+1], scl.v[gid*3+2]);
    vec3 trans = vec3(pos.v[gid*3+0], pos.v[gid*3+1], pos.v[gid*3+2]);
    float d    = dns.v[gid];

    vec3 T0, T1, T2;
    quatToMatrixTranspose(q, T0, T1, T2);
    vec3 kscl = kernelScale(d, ap.minResponse, ap.densityClamping, ap.kernelDegree) * scale * ICOSA_VRT_SCALE;

    // 12 canonical icosahedron vertices (matches the CUDA template)
    vec3 V[12] = vec3[12](
        vec3(-1, GOLDEN, 0), vec3(1, GOLDEN, 0), vec3(0, 1, -GOLDEN),
        vec3(-GOLDEN, 0, -1), vec3(-GOLDEN, 0, 1), vec3(0, 1, GOLDEN),
        vec3(GOLDEN, 0, 1), vec3(0, -1, GOLDEN), vec3(-1, -GOLDEN, 0),
        vec3(0, -1, -GOLDEN), vec3(GOLDEN, 0, -1), vec3(1, -GOLDEN, 0));

    uint sVert = gid * NUM_VERT;
    vec3 lo = vec3(3.0e38), hi = vec3(-3.0e38);
    for (uint i = 0u; i < NUM_VERT; ++i) {
        vec3 local = V[i] * kscl;
        vec3 w = vec3(dot(T0, local), dot(T1, local), dot(T2, local)) + trans;  // (v * R^T) + trans
        verts.v[(sVert + i)*3 + 0] = w.x;
        verts.v[(sVert + i)*3 + 1] = w.y;
        verts.v[(sVert + i)*3 + 2] = w.z;
        lo = min(lo, w);
        hi = max(hi, w);
    }
    // min/max are exact, so the reduction order cannot change the result
    lo = subgroupMin(lo);
    hi = subgroupMax(hi);
    if (subgroupElect()) {
        atomicMin(bounds.v[0], orderedBits(lo.x));
        atomicMin(bounds.v[1], orderedBits(lo.y));
        atomicMin(bounds.v[2], orderedBits(lo.z));
        atomicMax(bounds.v[3], orderedBits(hi.x));
        atomicMax(bounds.v[4], orderedBits(hi.y));
        atomicMax(bounds.v[5], orderedBits(hi.z));
    }
    if (ap.writeIndices == 0u) return;

    // 20 triangles (matches the CUDA template), offset into this gaussian's verts
    const uint T[60] = uint[60](
        0,1,2,  0,2,3,  0,3,4,  0,4,5,  0,5,1,
        6,1,5,  6,5,7,  6,7,11, 6,11,10, 6,10,1,
        8,4,3,  8,3,9,  8,9,11, 8,11,7, 8,7,4,
        9,3,2,  9,2,10, 9,10,11,
        5,4,7,  1,10,2);
    uint sTri = gid * NUM_TRI;
    for (uint t = 0u; t < NUM_TRI; ++t) {
        idx.v[(sTri + t)*3 + 0] = sVert + T[t*3 + 0];
        idx.v[(sTri + t)*3 + 1] = sVert + T[t*3 + 1];
        idx.v[(sTri + t)*3 + 2] = sVert + T[t*3 + 2];
    }
}
